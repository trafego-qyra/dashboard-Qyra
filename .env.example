# ---------------------------------------------------------------------------
# Dashboard QYRA — variáveis de ambiente
#
# Copie para .env.local. Sem credencial nenhuma, o painel roda em modo de
# demonstração com dados fictícios — nada quebra.
#
# Como obter cada credencial: docs/integracoes.md
# ---------------------------------------------------------------------------

# Força dados fictícios mesmo com credencial configurada.
# Recomendado em ambiente de preview.
QYRA_FORCE_MOCK=false

# ---- Acesso ao painel ------------------------------------------------------

# Senha única, a mesma para toda a equipe. OBRIGATÓRIA em produção: sem ela o
# painel tranca tudo e mostra um aviso, em vez de ficar aberto na internet.
# Em desenvolvimento, deixar em branco libera o acesso local.
QYRA_SENHA=

# Opcional. Por padrão a sessão é assinada com a própria senha, então trocar a
# senha desloga todo mundo — que costuma ser o desejado. Defina este valor se
# quiser trocar a senha SEM derrubar as sessões em aberto.
QYRA_SESSAO_SECRET=

# ---- Meta Ads --------------------------------------------------------------
# Token de usuário do sistema com escopo ads_read.
META_ACCESS_TOKEN=
# ID da conta de anúncios, com ou sem o prefixo act_.
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0

# ---- Meta: API de Conversões (eventos de CRM) ------------------------------
# Manda para a Meta o que aconteceu com o lead depois do anúncio. Sem isso a
# Meta otimiza por lead barato; com isso, por lead que fecha.
# Como obter: Gerenciador de Eventos > o conjunto de dados > Conectar CRM >
# Conectar manualmente. Ver docs/integracoes.md.

# O conjunto de dados que recebe os eventos. Não é segredo.
META_CAPI_DATASET_ID=
# Token DO CONJUNTO DE DADOS. É segredo, e NÃO é o META_ACCESS_TOKEN acima:
# aquele lê métrica de anúncio, este escreve evento.
META_CAPI_ACCESS_TOKEN=
# Separada da META_API_VERSION de propósito: a Insights está presa em v21.0 e
# a instrução de CRM da Meta pede v26.0.
META_CAPI_API_VERSION=v26.0
# Código TESTxxxxx da aba "Eventos de teste". PREENCHIDO, NADA ENTRA EM
# PRODUÇÃO — todo envio vai para a aba de teste. Deixe vazio só quando a
# integração já estiver validada e for para valer.
META_CAPI_TEST_EVENT_CODE=

# ---- Orgânico: Instagram e Facebook ---------------------------------------
# Reaproveita META_ACCESS_TOKEN; exige instagram_basic,
# instagram_manage_insights e pages_read_engagement.
META_IG_USER_ID=
META_PAGE_ID=

# ---- Google: OAuth compartilhado por Ads e GA4 -----------------------------
# Escopos: .../auth/adwords e .../auth/analytics.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Google Ads ------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
# Aceita com ou sem hífen.
GOOGLE_ADS_CUSTOMER_ID=
# Só quando o acesso é via conta gerente (MCC).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v18

# ---- Google Analytics 4 ----------------------------------------------------
# ID numérico da propriedade — não é o G-XXXXXXX.
GA4_PROPERTY_ID=

# ---- Observabilidade -------------------------------------------------------
# Sem DSN, o Sentry não inicializa e nada é enviado.
NEXT_PUBLIC_SENTRY_DSN=

# ---- Ajustes de operação ---------------------------------------------------
# TTL do cache de relatórios, em segundos.
REPORT_CACHE_TTL=300
# Teto de requisições por IP nas rotas de API.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ---- Supabase: fila dos eventos de CRM -------------------------------------
# Guarda o que foi enviado para a Meta, o que falhou e o que não tinha como ser
# identificado. Sem isso não há idempotência, retentativa nem auditoria.
# O SQL da tabela está em docs/sql/evento-crm.sql.

# URL do projeto. Não é segredo.
SUPABASE_URL=
# Chave service_role. É SEGREDO, e é a mais perigosa do projeto: ignora as
# políticas de linha do Postgres. Nunca em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Kommo (CRM de vendas) -------------------------------------------------

# O nome que aparece na URL da conta: https://SUBDOMINIO.kommo.com
KOMMO_SUBDOMAIN=

# Chave de longa duração da integração privada (Kommo > Configurações >
# Integrações > sua integração > Chaves e escopos). Sem ela a tela de Vendas
# roda em demonstração. Ver docs/integracoes.md.
KOMMO_ACCESS_TOKEN=

# Opcional: o funil de vendas, quando a conta tem mais de um. `142` é etapa de
# ganho em todo funil do Kommo, então sem isto um pipeline de suporte entraria
# no faturamento. O id aparece na URL do funil.
KOMMO_PIPELINE_ID=
