{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3211",
      "url": [
        "http://localhost:3211/",
        "http://localhost:3211/meta-ads",
        "http://localhost:3211/analytics"
      ],
      "numberOfRuns": 2,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["off"],
        "first-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 400000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 900000 }],
        "unused-javascript": ["warn", { "maxNumericValue": 120000 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
