{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}",
    "src/instrumentation{,-client}.ts",
    "tests/**/*.{test,spec}.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/mocks/**"],
  "ignoreDependencies": ["tailwindcss"]
}
